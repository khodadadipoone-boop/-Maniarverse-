        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n\n    START([Start Child Experience])\n\n    LOAD_CHILD[Load Child Profile]\n\n    FIRST_MEETING_DONE{\n        first_meeting_completed_at\n        is not NULL?\n    }\n\n    FIRST_MEETING[First Meeting with Maniyar]\n    CHILD_CONTINUES{Child wants to continue?}\n    SAFE_EXIT[Pause or Exit Without Pressure]\n\n    COMPLETE_FIRST_MEETING[Complete First Meeting]\n    SAVE_FIRST_MEETING[\n        Save current timestamp in\n        first_meeting_completed_at\n    ]\n\n    SELECT_WORLD[World Selection Screen]\n    CHOOSE_WORLD{Choose a World}\n\n    JOY[Joy World]\n    CALM[Calm World]\n    INNER[Inner World]\n\n    EXPERIENCE[Experience Selected World]\n\n    EXPERIENCE_ACTION{\n        Continue, Pause,\n        Finish or Exit?\n    }\n\n    SAVE_PROGRESS[Save Progress]\n    EXIT_EXPERIENCE[Exit Experience Safely]\n    COMPLETE_EXPERIENCE[Complete Experience]\n\n    CREATE_MEMORY{Create Memory Capsule?}\n    MEMORY_TYPE{Select Memory Type}\n\n    PHOTO[Upload Photo]\n    VIDEO[Upload Video]\n    NOTE[Write Note]\n\n    MEMORY_SAVED{Memory saved successfully?}\n    MEMORY_ERROR[Show Upload or Save Error]\n    MEMORY_GALLERY[View Memory Gallery]\n\n    EXPERIENCE_DONE[Experience Completed]\n\n    NEXT_ACTION{What next?}\n\n    CHILD_HOME[Return to Child Home]\n    ANOTHER_WORLD[Choose Another World]\n    PARENT_AREA[Return to Parent Area]\n\n    END([End])\n\n    START --&gt; LOAD_CHILD\n    LOAD_CHILD --&gt; FIRST_MEETING_DONE\n\n    FIRST_MEETING_DONE --&gt;|No| FIRST_MEETING\n    FIRST_MEETING_DONE --&gt;|Yes| SELECT_WORLD\n\n    FIRST_MEETING --&gt; CHILD_CONTINUES\n\n    CHILD_CONTINUES --&gt;|No| SAFE_EXIT\n    SAFE_EXIT --&gt; CHILD_HOME\n\n    CHILD_CONTINUES --&gt;|Yes| COMPLETE_FIRST_MEETING\n    COMPLETE_FIRST_MEETING --&gt; SAVE_FIRST_MEETING\n    SAVE_FIRST_MEETING --&gt; SELECT_WORLD\n\n    SELECT_WORLD --&gt; CHOOSE_WORLD\n\n    CHOOSE_WORLD --&gt;|Joy| JOY\n    CHOOSE_WORLD --&gt;|Calm| CALM\n    CHOOSE_WORLD --&gt;|Inner| INNER\n\n    JOY --&gt; EXPERIENCE\n    CALM --&gt; EXPERIENCE\n    INNER --&gt; EXPERIENCE\n\n    EXPERIENCE --&gt; EXPERIENCE_ACTION\n\n    EXPERIENCE_ACTION --&gt;|Continue| EXPERIENCE\n\n    EXPERIENCE_ACTION --&gt;|Pause| SAVE_PROGRESS\n    SAVE_PROGRESS --&gt; CHILD_HOME\n\n    EXPERIENCE_ACTION --&gt;|Exit| EXIT_EXPERIENCE\n    EXIT_EXPERIENCE --&gt; CHILD_HOME\n\n    EXPERIENCE_ACTION --&gt;|Finish| COMPLETE_EXPERIENCE\n    COMPLETE_EXPERIENCE --&gt; CREATE_MEMORY\n\n    CREATE_MEMORY --&gt;|No| EXPERIENCE_DONE\n    CREATE_MEMORY --&gt;|Yes| MEMORY_TYPE\n\n    MEMORY_TYPE --&gt;|Photo| PHOTO\n    MEMORY_TYPE --&gt;|Video| VIDEO\n    MEMORY_TYPE --&gt;|Note| NOTE\n\n    PHOTO --&gt; MEMORY_SAVED\n    VIDEO --&gt; MEMORY_SAVED\n    NOTE --&gt; MEMORY_SAVED\n\n    MEMORY_SAVED --&gt;|No| MEMORY_ERROR\n    MEMORY_ERROR --&gt; MEMORY_TYPE\n\n    MEMORY_SAVED --&gt;|Yes| MEMORY_GALLERY\n    MEMORY_GALLERY --&gt; EXPERIENCE_DONE\n\n    EXPERIENCE_DONE --&gt; NEXT_ACTION\n\n    NEXT_ACTION --&gt;|Child Home| CHILD_HOME\n    NEXT_ACTION --&gt;|Another World| ANOTHER_WORLD\n    NEXT_ACTION --&gt;|Parent Area| PARENT_AREA\n\n    ANOTHER_WORLD --&gt; SELECT_WORLD\n    CHILD_HOME --&gt; END\n    PARENT_AREA --&gt; END&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_UzTJulanRrXewWApxds-1">
