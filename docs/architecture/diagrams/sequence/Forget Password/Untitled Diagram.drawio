  <diagram name="Page-1" id="fGwBgeGFs6jx-tIbmBEG">
    <mxGraphModel dx="1094" dy="582" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Parent as Parent (User)\n    participant Frontend as Frontend (App/Web)\n    participant Backend as Backend API (FastAPI)\n    participant DB as Database (PostgreSQL)\n    participant EmailService as Email Service (Resend)\n\n    %% Step 1: Request Reset Link\n    rect rgb(240, 248, 255)\n        note over Parent, EmailService: Step 1: Request Password Reset\n        Parent-&gt;&gt;Frontend: Click \&quot;Forgot Password\&quot; &amp; enter email\n        Frontend-&gt;&gt;Backend: POST /api/auth/forgot-password (email)\n        Backend-&gt;&gt;DB: Query parent by email\n        \n        alt Account exists\n            DB--&gt;&gt;Backend: Return parent record\n            Backend-&gt;&gt;Backend: Generate secure reset token (15m expiry)\n            Backend-&gt;&gt;DB: Save reset_token_hash and expires_at\n            Backend-)EmailService: Trigger async reset email\n            EmailService--&gt;&gt;Parent: Deliver email with reset link (?token=...)\n        else Account does not exist\n            DB--&gt;&gt;Backend: No record found\n            note over Backend: Silent ignore (prevent email enumeration)\n        end\n        \n        Backend--&gt;&gt;Frontend: 200 OK (\&quot;If email is registered, reset link was sent\&quot;)\n        Frontend--&gt;&gt;Parent: Display generic confirmation message\n    end\n\n    %% Step 2: Set New Password\n    rect rgb(245, 255, 250)\n        note over Parent, EmailService: Step 2: Set New Password\n        Parent-&gt;&gt;Frontend: Open reset link, enter new password\n        Frontend-&gt;&gt;Backend: POST /api/auth/reset-password (token, new_password)\n        \n        Backend-&gt;&gt;DB: Verify reset token &amp; expiration\n        \n        alt Token valid and not expired\n            DB--&gt;&gt;Backend: Token valid, return parent record\n            Backend-&gt;&gt;Backend: Hash new password (argon2 / bcrypt)\n            Backend-&gt;&gt;DB: UPDATE password_hash, clear reset_token\n            DB--&gt;&gt;Backend: Update successful\n            Backend--&gt;&gt;Frontend: 200 OK (\&quot;Password reset successfully\&quot;)\n            Frontend--&gt;&gt;Parent: Show success message &amp; redirect to Login\n        else Token invalid or expired\n            DB--&gt;&gt;Backend: Token invalid or expired\n            Backend--&gt;&gt;Frontend: 400 Bad Request (\&quot;Invalid or expired reset link\&quot;)\n            Frontend--&gt;&gt;Parent: Show error &amp; prompt for new link\n        end\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="34UKpHelArbX5e-XtrgM-1">
