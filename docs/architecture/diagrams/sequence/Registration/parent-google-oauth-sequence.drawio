  <diagram name="Page-1" id="IA_h1BUXWh9uGOtkqCWt">
    <mxGraphModel dx="1094" dy="582" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Parent as Parent (User)\n    participant FE as Frontend (App/Web)\n    participant Google as Google OAuth Server\n    participant BE as Backend API (FastAPI)\n    participant DB as Database (PostgreSQL)\n\n    rect rgb(30, 30, 30)\n        note over Parent, DB: Google Social Registration &amp; Login Workflow\n    end\n\n    Parent-&gt;&gt;FE: 1. Click \&quot;Continue with Google\&quot;\n    FE-&gt;&gt;Google: 2. Open Google Auth Consent Screen\n    Google--&gt;&gt;Parent: 3. Prompt for Account Selection &amp; Consent\n    Parent-&gt;&gt;Google: 4. Select Account &amp; Grant Access\n    Google--&gt;&gt;FE: 5. Redirect with Authorization Code (or ID Token)\n    \n    FE-&gt;&gt;BE: 6. POST /api/auth/google (auth_code / id_token)\n    \n    BE-&gt;&gt;Google: 7. Verify Token &amp; Fetch User Profile Info\n    Google--&gt;&gt;BE: 8. Return Verified Profile (email, name, email_verified=true)\n\n    BE-&gt;&gt;DB: 9. SELECT * FROM parents WHERE email = google_email\n    DB--&gt;&gt;BE: 10. Return Query Result\n\n    alt Case A: First-Time User (New Registration)\n        BE-&gt;&gt;DB: 11. INSERT INTO parents (email, auth_provider=&#39;google&#39;, is_email_verified=TRUE, password_hash=NULL)\n        DB--&gt;&gt;BE: 12. Success: Parent Account Created\n    else Case B: Existing User (Direct Sign-In)\n        BE-&gt;&gt;DB: 11. UPDATE parents SET last_active_at = NOW() WHERE id = user.id\n        DB--&gt;&gt;BE: 12. Success: User Updated\n    end\n\n    BE-&gt;&gt;BE: 13. Generate Maniarverse JWT Tokens (Access &amp; Refresh)\n    BE--&gt;&gt;FE: 14. HTTP 200 OK (Return JWT Tokens &amp; Parent Info)\n    FE--&gt;&gt;Parent: 15. Sign-in Success &amp; Redirect to Parent Dashboard\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="P7xb9psYojx8lqpYf8zP-1">
