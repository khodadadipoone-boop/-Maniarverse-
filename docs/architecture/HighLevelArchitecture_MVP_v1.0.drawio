        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n%% =========================\n%% USERS\n%% =========================\n\nsubgraph USERS[\&quot;Users\&quot;]\n\nPARENT[Parent]\nCHILD[Child]\n\nend\n\n%% =========================\n%% FRONTEND\n%% =========================\n\nsubgraph FRONTEND[\&quot;Frontend — Next.js\&quot;]\n\nWEB[Web Application]\n\nPARENT_UI[Parent Interface]\n\nCHILD_UI[Child Experience Interface]\n\nWEB --&gt; PARENT_UI\nWEB --&gt; CHILD_UI\n\nend\n\n%% =========================\n%% BACKEND\n%% =========================\n\nsubgraph BACKEND[\&quot;Backend — FastAPI\&quot;]\n\nAPI[REST API]\n\nAUTH[Authentication]\n\nPARENT_SERVICE[Parent Service]\n\nCHILD_SERVICE[Child Service]\n\nWORLD_SERVICE[World Experience Service]\n\nMEMORY_SERVICE[Memory Service]\n\nSUMMARY_SERVICE[Parent Summary Service]\n\nAPI --&gt; AUTH\nAPI --&gt; PARENT_SERVICE\nAPI --&gt; CHILD_SERVICE\nAPI --&gt; WORLD_SERVICE\nAPI --&gt; MEMORY_SERVICE\nAPI --&gt; SUMMARY_SERVICE\n\nend\n\n%% =========================\n%% DATABASE\n%% =========================\n\nsubgraph DATABASE[\&quot;Database\&quot;]\n\nDB[(PostgreSQL)]\n\nend\n\n%% =========================\n%% STORAGE\n%% =========================\n\nsubgraph STORAGE[\&quot;Storage\&quot;]\n\nFILES[(Object Storage)]\n\nend\n\n%% =========================\n%% CONNECTIONS\n%% =========================\n\nPARENT --&gt; WEB\nCHILD --&gt; WEB\n\nWEB --&gt; API\n\nAUTH --&gt; DB\n\nPARENT_SERVICE --&gt; DB\n\nCHILD_SERVICE --&gt; DB\n\nWORLD_SERVICE --&gt; DB\n\nSUMMARY_SERVICE --&gt; DB\n\nMEMORY_SERVICE --&gt; DB\n\nMEMORY_SERVICE --&gt; FILES&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ID7rubW-G6yPdKvHyQOw-1">
